---
import ShareSection from "../components/ShareSection.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";
import {
  siirYayindaMi,
  tariheGoreYenidenEskiye
} from "../utils/yayin";

interface YeniSiir {
  baslik: string;
  adres: string;
  dizeler: string[];
}

interface SonEklenenIcerik {
  baslik: string;
  adres: string;
  tarih: Date;
  sira: number;
}

const siirler = await getCollection(
  "siirler",
  ({ data }) => siirYayindaMi(data)
);

const yeniSiirler: YeniSiir[] = [...siirler]
  .sort((birinci, ikinci) =>
    tariheGoreYenidenEskiye(birinci.data, ikinci.data)
  )
  .slice(0, 5)
  .map((siir) => ({
    baslik: siir.data.baslik,
    adres: `/siirler/${siir.id}.html`,
    dizeler: siir.data.siirMetni
      .split(/\n\s*\n/)[0]
      .split("\n")
      .map((dize) => dize.trim())
      .filter(Boolean)
  }));

const sonEklenenIcerikler: SonEklenenIcerik[] = siirler
  .map((siir) => ({
    baslik: siir.data.baslik,
    adres: `/siirler/${siir.id}.html`,
    tarih: siir.data.tarih,
    sira: siir.data.sira
  }))
  .sort(tariheGoreYenidenEskiye)
  .slice(0, 10);
---

<SiteLayout
  aktifMenu="ana-sayfa"
  aciklama="Mehmet Aykurt’un şiir, edebiyat ve müzik çalışmalarını bir araya getiren resmî web sitesi."
  baslik="Mehmet Aykurt Resmî Web Sitesi"
  canonicalYolu="/"
>
  <section aria-labelledby="metin-basligi" class="metin">
    <h1 id="metin-basligi">Hoş Geldiniz</h1>
    <p>
      Mehmet Aykurt’un şiir, edebiyat ve müzik çalışmalarını bir araya getiren
      resmî web sitesine hoş geldiniz.
    </p>
  </section>

  <section aria-labelledby="yeni-siirler-basligi" class="icerik-listesi">
    <h2 id="yeni-siirler-basligi">Yeni Şiirler</h2>
    {
      yeniSiirler.map((siir) => (
        <article class="icerik-karti">
          <h3>{siir.baslik}</h3>
          <p>
            {siir.dizeler.map((dize, sira, dizeler) => (
              <>
                {dize}
                {sira < dizeler.length - 1 && <br />}
              </>
            ))}
          </p>
          <div class="baglanti-alani">
            <a href={siir.adres}>Devamını oku</a>
          </div>
        </article>
      ))
    }
  </section>

  <section aria-labelledby="son-eklenenler-basligi" class="bolum">
    <h2 id="son-eklenenler-basligi">Son Eklenen İçerikler</h2>
    <ol>
      {
        sonEklenenIcerikler.map((icerik) => (
          <li><a href={icerik.adres}>{icerik.baslik}</a></li>
        ))
      }
    </ol>
  </section>

  <ShareSection adres="https://mehmetaykurt.com.tr/" />
</SiteLayout>
